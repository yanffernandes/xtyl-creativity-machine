# ============================================
# Backend Environment Variables (NestJS)
# ============================================

# ============================================
# Node Environment
# ============================================
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
BACKEND_PORT=3000
BACKEND_LOG_LEVEL=debug
# Backend URL (used for OAuth callbacks - must be publicly accessible)
BACKEND_URL=http://localhost:3001

# ============================================
# Supabase Configuration
# ============================================
# Get from: https://supabase.com/dashboard/project/_/settings/api

# Service Role Key (for backend - KEEP SECRET!)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (found in Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-super-secret-jwt-secret-32-chars-min

# ============================================
# Database Configuration
# ============================================
# Get from: https://supabase.com/dashboard/project/_/settings/database

# Pooled connection (for queries) - PgBouncer on port 6543
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (for migrations) - Direct PostgreSQL on port 5432
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost  # or 'redis' in Docker
REDIS_PORT=6379
REDIS_PASSWORD=       # Leave empty for local dev

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ============================================
# Temporal Configuration
# ============================================
# Temporal Server address (from Easypanel or local)
TEMPORAL_ADDRESS=localhost:7233

# Task queue name for workers
TEMPORAL_TASK_QUEUE=alvobot-tasks

# ============================================
# WordPress Integration
# ============================================
# Encryption key for WordPress credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ============================================
# OpenAI Configuration
# ============================================
# API key for GPT-4o-mini (used for AI generation and keyword suggestions)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Google AI Configuration (Imagen 3)
# ============================================
# API key for Google AI / Imagen 3 (used for AI image generation)
# Get from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# ============================================
# OpenRouter Configuration
# ============================================
# API key for OpenRouter (unified access to 400+ AI models)
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# ============================================
# RapidAPI Configuration
# ============================================
# API key for Google Keyword Insight (keyword mining)
# Get from: https://rapidapi.com/rhmueed/api/google-keyword-insight1
RAPIDAPI_KEY=your-rapidapi-key-here

# ============================================
# Supabase Configuration (Database URL)
# ============================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co

# ============================================
# Frontend URL (for OAuth callbacks)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Google Ads API Configuration
# ============================================
# OAuth 2.0 credentials (from Google Cloud Console)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret

# Developer Token (from Google Ads API Center)
# Get from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=XXX-XXX-XXXX

# OAuth callback URL
GOOGLE_ADS_CALLBACK_URL=http://localhost:3001/google/oauth/callback

# ============================================
# Google Ad Manager API Configuration
# ============================================
# OAuth 2.0 credentials (from Google Cloud Console)
# Enable the "Ad Manager API" in your Google Cloud project
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_AD_MANAGER_CLIENT_ID=your-ad-manager-client-id.apps.googleusercontent.com
GOOGLE_AD_MANAGER_CLIENT_SECRET=your-ad-manager-client-secret

# OAuth callback URL (defaults to BACKEND_URL + /ad-manager/oauth/callback)
# GOOGLE_AD_MANAGER_REDIRECT_URI=http://localhost:3001/ad-manager/oauth/callback

# ============================================
# Email Service (Resend)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender address (must be verified in Resend)
EMAIL_FROM=AlvoBot <noreply@alvobot.com>

# ============================================
# Stripe Configuration (Payments & Subscriptions)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Webhook secret for verifying Stripe events
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe Price IDs for subscription plans
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxx

# ============================================
# WordPress Webhook URLs (External N8N) - DEPRECATED
# ============================================
# These webhooks are now replaced by direct OpenAI integration
# Kept for backwards compatibility
WEBHOOK_AUTHOR_URL=https://webhook-app.crisfranklin.com.br/webhook/cd7bfc18-ab8e-4257-8e15-58c722326ec4
WEBHOOK_TITLE_URL=https://webhook-app.crisfranklin.com.br/webhook/25101007-4668-4035-bf5e-b07218564460
WEBHOOK_LOGO_URL=https://webhook-app.crisfranklin.com.br/webhook/18b254b9-d702-497f-9525-fda429689a90
