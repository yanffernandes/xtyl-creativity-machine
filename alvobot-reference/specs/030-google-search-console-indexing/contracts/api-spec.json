{
  "openapi": "3.0.3",
  "info": {
    "title": "Search Console Integration",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:3001" }],
  "paths": {
    "/search-console/connections": {
      "get": {
        "summary": "List connections",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/search-console/properties": {
      "get": {
        "summary": "List properties for active connection",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/search-console/inspect": {
      "post": {
        "summary": "Inspect URL index status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "Not authorized" }
        }
      }
    },
    "/search-console/index": {
      "post": {
        "summary": "Request indexing for a single URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IndexRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Queued or sent" },
          "400": { "description": "Ineligible URL" },
          "429": { "description": "Quota exceeded" }
        }
      }
    },
    "/search-console/index/batch": {
      "post": {
        "summary": "Request indexing for multiple URLs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BatchIndexRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Batch queued" },
          "429": { "description": "Quota exceeded" }
        }
      }
    },
    "/search-console/quota": {
      "get": {
        "summary": "Get quota usage for active connection",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/search-console/auto-run": {
      "post": {
        "summary": "Trigger manual auto-run for a connection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AutoRunRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Started" } }
      }
    }
  },
  "components": {
    "schemas": {
      "InspectRequest": {
        "type": "object",
        "required": ["url", "propertyId"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "propertyId": { "type": "string" }
        }
      },
      "IndexRequest": {
        "type": "object",
        "required": ["url", "articleId", "connectionId"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "articleId": { "type": "string" },
          "connectionId": { "type": "string" }
        }
      },
      "BatchIndexRequest": {
        "type": "object",
        "required": ["connectionId", "items"],
        "properties": {
          "connectionId": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BatchIndexItem" }
          }
        }
      },
      "BatchIndexItem": {
        "type": "object",
        "required": ["url", "articleId"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "articleId": { "type": "string" }
        }
      },
      "AutoRunRequest": {
        "type": "object",
        "required": ["connectionId"],
        "properties": {
          "connectionId": { "type": "string" }
        }
      }
    }
  }
}
