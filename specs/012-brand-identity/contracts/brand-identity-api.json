{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Identity API Contracts",
  "description": "API endpoint contracts for Feature 012 - Brand Identity Settings",
  "version": "1.0.0",
  "date": "2025-11-30",

  "endpoints": {
    "GET /projects/{project_id}/settings": {
      "description": "Get project settings including brand identity (existing endpoint, extended response)",
      "authentication": "Required (JWT)",
      "parameters": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "Project ID"
        }
      },
      "response": {
        "200": {
          "description": "Project settings retrieved successfully",
          "schema": {
            "type": "object",
            "properties": {
              "client_name": { "type": "string" },
              "description": { "type": ["string", "null"] },
              "target_audience": { "type": ["string", "null"] },
              "brand_voice": { "type": ["string", "null"] },
              "brand_voice_custom": { "type": ["string", "null"] },
              "key_messages": { "type": ["array", "null"], "items": { "type": "string" } },
              "competitors": { "type": ["array", "null"], "items": { "type": "string" } },
              "custom_notes": { "type": ["string", "null"] },
              "brand_identity": {
                "type": ["object", "null"],
                "properties": {
                  "color_palette": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
                    "maxItems": 6,
                    "description": "Ordered HEX colors (index 0 = primary)"
                  },
                  "typography": {
                    "type": ["object", "null"],
                    "properties": {
                      "primary": { "type": ["string", "null"], "maxLength": 100 },
                      "secondary": { "type": ["string", "null"], "maxLength": 100 },
                      "tertiary": { "type": ["string", "null"], "maxLength": 100 }
                    }
                  }
                }
              }
            }
          },
          "example": {
            "client_name": "Acme Corp",
            "description": "Marketing materials for Q1 2025",
            "target_audience": "Young professionals aged 25-35",
            "brand_voice": "creative_playful",
            "brand_voice_custom": null,
            "key_messages": ["Innovation", "Quality"],
            "competitors": ["CompetitorA", "CompetitorB"],
            "custom_notes": null,
            "brand_identity": {
              "color_palette": ["#5B8DEF", "#4A7AD9", "#7AA5F5"],
              "typography": {
                "primary": "Montserrat",
                "secondary": "Open Sans",
                "tertiary": "Roboto"
              }
            }
          }
        },
        "404": {
          "description": "Project not found",
          "schema": {
            "type": "object",
            "properties": {
              "detail": { "type": "string" }
            }
          },
          "example": { "detail": "Project not found" }
        }
      }
    },

    "PUT /projects/{project_id}/settings": {
      "description": "Update project settings including brand identity (existing endpoint, extended payload)",
      "authentication": "Required (JWT)",
      "parameters": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "Project ID"
        }
      },
      "requestBody": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": ["client_name"],
          "properties": {
            "client_name": { "type": "string", "maxLength": 200 },
            "description": { "type": ["string", "null"], "maxLength": 2000 },
            "target_audience": { "type": ["string", "null"], "maxLength": 1000 },
            "brand_voice": { "type": ["string", "null"] },
            "brand_voice_custom": { "type": ["string", "null"], "maxLength": 500 },
            "key_messages": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 10 },
            "competitors": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 10 },
            "custom_notes": { "type": ["string", "null"], "maxLength": 5000 },
            "brand_identity": {
              "type": ["object", "null"],
              "properties": {
                "color_palette": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
                  "maxItems": 6
                },
                "typography": {
                  "type": ["object", "null"],
                  "properties": {
                    "primary": { "type": ["string", "null"], "maxLength": 100 },
                    "secondary": { "type": ["string", "null"], "maxLength": 100 },
                    "tertiary": { "type": ["string", "null"], "maxLength": 100 }
                  }
                }
              }
            }
          }
        },
        "example": {
          "client_name": "Acme Corp",
          "description": "Marketing materials for Q1 2025",
          "brand_identity": {
            "color_palette": ["#5B8DEF", "#4A7AD9", "#7AA5F5"],
            "typography": {
              "primary": "Montserrat",
              "secondary": "Open Sans",
              "tertiary": null
            }
          }
        }
      },
      "response": {
        "200": {
          "description": "Settings updated successfully",
          "schema": {
            "type": "object",
            "properties": {
              "settings": { "type": "object" },
              "project_name": { "type": "string" }
            }
          }
        },
        "400": {
          "description": "Validation error",
          "example": { "detail": "Invalid HEX color: #GGGGGG" }
        },
        "404": {
          "description": "Project not found",
          "example": { "detail": "Project not found" }
        }
      }
    },

    "POST /projects/{project_id}/extract-colors": {
      "description": "Extract dominant colors from uploaded image (NEW endpoint)",
      "authentication": "Required (JWT)",
      "parameters": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "Project ID"
        }
      },
      "requestBody": {
        "contentType": "multipart/form-data",
        "schema": {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "format": "binary",
              "description": "Image file (PNG, JPG, WEBP)",
              "maxSize": "5MB"
            },
            "n_colors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 6,
              "description": "Number of colors to extract"
            }
          }
        }
      },
      "response": {
        "200": {
          "description": "Colors extracted successfully",
          "schema": {
            "type": "object",
            "properties": {
              "colors": {
                "type": "array",
                "items": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
                "description": "Extracted colors sorted by prevalence"
              },
              "source_filename": { "type": "string" },
              "processing_time_ms": { "type": "integer" },
              "message": { "type": ["string", "null"] }
            }
          },
          "example": {
            "colors": ["#5B8DEF", "#FFFFFF", "#4A7AD9", "#0A0E14", "#7AA5F5", "#F5F5F5"],
            "source_filename": "logo.png",
            "processing_time_ms": 842,
            "message": null
          }
        },
        "400": {
          "description": "Invalid file or validation error",
          "examples": [
            { "detail": "File type not supported. Use PNG, JPG, or WEBP." },
            { "detail": "File too large. Maximum size is 5MB." },
            { "detail": "No file uploaded" }
          ]
        },
        "422": {
          "description": "Processing error",
          "example": { "detail": "Could not process image. File may be corrupted." }
        }
      }
    },

    "POST /projects/{project_id}/extract-colors-from-asset": {
      "description": "Extract colors from existing project asset (NEW endpoint, P3 feature)",
      "authentication": "Required (JWT)",
      "parameters": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "required": true
        }
      },
      "requestBody": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": ["asset_id"],
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID of existing visual asset in project"
            },
            "n_colors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 6
            }
          }
        }
      },
      "response": {
        "200": {
          "description": "Colors extracted successfully",
          "schema": {
            "type": "object",
            "properties": {
              "colors": { "type": "array", "items": { "type": "string" } },
              "source_asset_id": { "type": "string" },
              "source_asset_name": { "type": "string" },
              "processing_time_ms": { "type": "integer" },
              "message": { "type": ["string", "null"] }
            }
          }
        },
        "404": {
          "description": "Asset not found",
          "example": { "detail": "Asset not found in project" }
        }
      }
    }
  },

  "commonErrors": {
    "401": {
      "description": "Unauthorized - missing or invalid JWT",
      "example": { "detail": "Not authenticated" }
    },
    "403": {
      "description": "Forbidden - user lacks access to project",
      "example": { "detail": "Access denied" }
    },
    "500": {
      "description": "Internal server error",
      "example": { "detail": "Internal server error" }
    }
  }
}
