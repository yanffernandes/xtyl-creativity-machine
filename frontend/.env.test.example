# E2E Test Configuration
# Copy this file to .env.test and fill in the values

# Base URL for E2E tests (default: http://localhost:3000)
E2E_BASE_URL=http://localhost:3000

# Test account credentials (create a dedicated test account in Supabase)
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=your-test-password

# Optional: Test workspace ID (will be created if not provided)
E2E_TEST_WORKSPACE_ID=

# Optional: Backend URL for API tests
E2E_API_URL=http://localhost:8000
