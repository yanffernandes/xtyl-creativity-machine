{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/navigation": [
        "./src/vite/shims/next-navigation.ts"
      ],
      "next/link": [
        "./src/vite/shims/next-link.tsx"
      ],
      "next/image": [
        "./src/vite/shims/next-image.tsx"
      ],
      "next/dynamic": [
        "./src/vite/shims/next-dynamic.tsx"
      ],
      "next-intl": [
        "./src/vite/shims/next-intl.tsx"
      ],
      "next-intl/server": [
        "./src/vite/shims/next-intl-server.ts"
      ],
      "next/headers": [
        "./src/vite/shims/next-headers.ts"
      ],
      "next/font/google": [
        "./src/vite/shims/next-font-google.ts"
      ],
      "next": [
        "./src/vite/shims/next.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
