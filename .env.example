# ==================================
# XTYL Creativity Machine
# Environment Variables
# ==================================
# Copy to .env and fill with your values

# ============ FRONTEND ============
# Development: frontend uses /api and Vite proxies to apps/api on port 3000
# Production: keep /api behind nginx/reverse proxy
NEXT_PUBLIC_API_URL=/api
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:3000

# ============ SUPABASE DATABASE ============
# Get from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ============ SUPABASE AUTH ============
# Get from: Supabase Dashboard > Settings > API
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
# Service role key for admin operations (password reset, user creation)
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ============ CLOUDFLARE R2 STORAGE ============
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=xtyl-storage
R2_PUBLIC_URL=https://pub-[HASH].r2.dev

# ============ REDIS ============
# Development: redis://localhost:6379/0
# Production: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ EMAIL (BREVO) ============
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=XTYL Creativity Machine

# ============ APPLICATION ============
# Development: http://localhost:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application URL for OpenRouter HTTP-Referer header
# Use your production domain in production
APP_URL=https://xtyl.app
APP_TITLE=XTYL Creativity Machine

# ============ AI PROVIDERS ============
# OpenRouter (for LLM/text operations)
OPENROUTER_API_KEY=your-openrouter-key

# fal.ai (for Image Studio operations)
# Get from: https://fal.ai/dashboard/keys
FAL_KEY=your-fal-api-key

# Optional providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ============ AGNO SIDECAR ============
AGNO_API_URL=http://localhost:7777
AGNO_SHARED_SECRET=local-agno-secret

# ============ SENTRY ERROR TRACKING (OPTIONAL) ============
# Get from: Sentry Dashboard > Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://080afdb3aea0fc2422660ec54468d4b5@o4510519308648448.ingest.us.sentry.io/4510519309828096
VITE_SENTRY_DSN=https://080afdb3aea0fc2422660ec54468d4b5@o4510519308648448.ingest.us.sentry.io/4510519309828096
# For uploading source maps (optional)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============ NOTES ============
# 1. Copy this file to .env
# 2. Fill with your values
# 3. For production, update URLs and Redis to use docker service names
# 4. Configure Supabase Auth redirect URLs:
#    - Site URL: https://yourdomain.com
#    - Redirect URLs: https://yourdomain.com/auth/callback
# 5. SUPABASE_SERVICE_ROLE_KEY is required for:
#    - Password reset functionality
#    - User invitation/signup via invite link
