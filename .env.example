# ==================================
# XTYL Creativity Machine
# Environment Variables
# ==================================
# Copy to .env and fill with your values

# ============ SUPABASE DATABASE ============
# Get from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ============ SUPABASE AUTH ============
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase
SUPABASE_ANON_KEY=eyJ...your-anon-key
# Service role key for admin operations (password reset, user creation)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ============ VITE FRONTEND (apps/web, apps/admin) ============
# Used at build time — must be passed as Docker build args in production
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_API_URL=/api
VITE_SENTRY_DSN=

# ============ CLOUDFLARE R2 STORAGE ============
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=xtyl-storage
R2_PUBLIC_URL=https://pub-[HASH].r2.dev

# ============ REDIS ============
# Development: redis://localhost:6379/0
# Production: set REDIS_PASSWORD and docker-compose builds the URL
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ AI PROVIDERS ============
# OpenRouter (LLM/text)
OPENROUTER_API_KEY=your-openrouter-key
# fal.ai (Image Studio)
FAL_KEY=your-fal-api-key
# Optional
GROQ_API_KEY=
TAVILY_API_KEY=

# ============ EMAIL (BREVO) ============
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=XTYL Creativity Machine

# ============ APPLICATION ============
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_URL=https://xtyl.app
APP_TITLE=XTYL Creativity Machine

# ============ SENTRY (OPTIONAL) ============
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============ NOTES ============
# 1. Copy this file to .env and fill with your values
# 2. VITE_* vars are baked into the frontend bundle at build time
#    In Easypanel: set them as env vars — they're passed as Docker build args
# 3. For production Redis, set REDIS_PASSWORD and update REDIS_URL:
#    REDIS_URL=redis://:your-password@redis:6379/0
# 4. Configure Supabase Auth redirect URLs:
#    - Site URL: https://yourdomain.com
#    - Redirect URLs: https://yourdomain.com/auth/callback
